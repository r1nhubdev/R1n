    trackButton.Position = UDim2.new(0.45, 0, 0.5, 0)
    trackButton.Size = UDim2.new(0.55, -50, 0, 26)
    trackButton.BackgroundTransparency = 1
    trackButton.Text = ""
    trackButton.AutoButtonColor = false
    trackButton.Parent = row
    local track = Instance.new("Frame")
    track.Name = "Rail"
    track.Position = UDim2.new(0, 0, 0.5, -5)
    track.Size = UDim2.new(1, 0, 0, 10)
    track.BackgroundColor3 = Color3.fromRGB(38, 38, 43)
    track.BorderSizePixel = 0
    track.Parent = trackButton
    corner:Clone().Parent = track
    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = accentColor
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner:Clone().Parent = fill
    local dragging
    local sliderFillTween
    local function format(number)
        return string.format("%.4f", number):gsub("0+$", ""):gsub("%.$", "")
    end
    local function set(nextValue, silent)
        nextValue = tonumber(nextValue)
        if not nextValue or nextValue ~= nextValue then return end
        nextValue = math.clamp(minimum + math.floor((nextValue - minimum) / step + 0.5) * step, minimum, maximum)
        local changed = nextValue ~= value
        value = nextValue
        local progress = (value - minimum) / (maximum - minimum)
        if sliderFillTween then sliderFillTween:Cancel() end
        if silent then
            fill.Size = UDim2.fromScale(progress, 1)
        else
            sliderFillTween = TweenService:Create(fill,
                TweenInfo.new(dragging and 0.1 or 0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                { Size = UDim2.fromScale(progress, 1) })
            sliderFillTween:Play()
        end
        input.Text = format(value)
        row:SetAttribute("Value", value)
        if changed and not silent and options.Callback then options.Callback(value) end
    end
    local function fromPointer(x)
        if track.AbsoluteSize.X > 0 then
            set(minimum + math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1) * (maximum - minimum))
        end
    end
    table.insert(dragConnections, trackButton.InputBegan:Connect(function(event)
        if event.UserInputType == Enum.UserInputType.MouseButton1 or event.UserInputType == Enum.UserInputType.Touch then
            dragging = event
            fromPointer(event.Position.X)
        end
    end))
    table.insert(dragConnections, UserInputService.InputChanged:Connect(function(event)
        if not dragging then return end
        if event == dragging or (dragging.UserInputType == Enum.UserInputType.MouseButton1
            and event.UserInputType == Enum.UserInputType.MouseMovement) then
            fromPointer(event.Position.X)
        end
    end))
    table.insert(dragConnections, UserInputService.InputEnded:Connect(function(event)
        if event == dragging then dragging = nil end
    end))
    table.insert(dragConnections, UserInputService.WindowFocusReleased:Connect(function() dragging = nil end))
    table.insert(dragConnections, input.FocusLost:Connect(function()
        local number = tonumber((input.Text:gsub(",", ".")))
        if number then set(number) else input.Text = format(value) end
    end))
    set(options.Default or minimum, true)
    row.Destroying:Connect(function()
        dragging = nil
        if sliderFillTween then sliderFillTween:Cancel() end
    end)
    return { Row = row, Get = function() return value end, Set = set, Destroy = function() row:Destroy() end }
end

