function Library:CreateWindow(options)
    local api = buildWindow(options or {})
    self.CurrentWindow = api
    for key, value in api do
        if key ~= "CreateWindow" and key ~= "CreateKeySystem" then self[key] = value end
    end
    return api
end

function Library:CreateKeySystem(options)
    options = options or {}
    local window = self:CreateWindow({Title = options.Title or "Lowyx Hub", Description = "Key verification"})
    return window:CreateKeySystem(options)
end

return Library
