local function nebulaIcon(title, requested)
    if type(requested) == "string" and NebulaSymbols[requested] then return requested end
    local name = tostring(title):lower()
    for _, rule in {
        {"aim", "target"}, {"combat", "swords"}, {"kill", "skull"}, {"boss", "skull"},
        {"esp", "visibility"}, {"skin", "palette"}, {"weapon", "swords"}, {"knife", "swords"},
        {"glove", "apparel"}, {"teleport", "travel_explore"}, {"quest", "inventory_2"},
        {"player", "person"}, {"movement", "person"}, {"farm", "swords"}, {"race", "trophy"},
        {"fruit", "inventory_2"}, {"item", "inventory_2"}, {"stand", "bolt"}, {"skill", "bolt"},
        {"setting", "settings"}, {"config", "settings"}, {"random", "palette"},
        {"session", "settings"}, {"stat", "dashboard"}, {"dashboard", "dashboard"},
    } do
        if name:find(rule[1], 1, true) then return rule[2] end
    end
    return "dashboard"
end
local function normalize(props)
    props.Title = props.Title or props.Name or props.Text or "Component"
    props.Description = props.Description or props.Subtitle or ""
    if props.Description == "" and props.Type ~= "Paragraph" and props.Type ~= "Button" then
        local title = props.Title:lower()
        if props.Type == "Slider" then props.Description = "Adjust " .. title .. "."
        elseif props.Type == "Dropdown" or props.Type == "MultiDropdown" then props.Description = "Select " .. title .. "."
        elseif props.Type == "ColorPicker" then props.Description = "Choose the display color."
        elseif props.Type == "Keybind" then props.Description = "Click and press a key."
        else props.Description = "Enable " .. title .. "." end
    end
    if props.Default == nil then props.Default = props.Value end
    props.Multi = props.Multi == true or props.Type == "MultiDropdown"
    return props
end
local function registerHandle(handle, prefix, kind)
    api.Components[prefix] = handle
    local suffix = kind == "Toggle" and "Toggle1" or kind == "IconToggle" and "Toggle3"
        or (kind == "ColorToggle" or kind == "ColorPicker") and "Toggle2"
        or kind == "Input" and "Textbox" or kind == "MultiDropdown" and "Dropdown" or kind
    api.Components[prefix .. "." .. suffix] = handle
end
