        input.ZIndex = 56
        input.Parent = panel
        corner:Clone().Parent = input
        fields[name] = input
        local caption = title:Clone()
        caption.Position = input.Position - UDim2.fromOffset(0, 16)
        caption.Size = UDim2.new(0, input.Size.X.Offset, 0, 14)
        caption.TextSize = 10
        caption.TextColor3 = inactiveColor
        caption.Text = name
        caption.ZIndex = 56
        caption.Parent = panel
    end
    local function update(silent)
        color = Color3.fromHSV(hue, saturation, brightness)
        swatch.BackgroundColor3 = color
        palette.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
        marker.BackgroundColor3 = color
        marker.Position = UDim2.fromScale(saturation, 1 - brightness)
        hueMarker.Position = UDim2.fromScale(hue, 0.5)
        hueMarker.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
        fields.HEX.Text = "#" .. color:ToHex():upper()
        fields.R.Text = tostring(math.floor(color.R * 255 + 0.5))
        fields.G.Text = tostring(math.floor(color.G * 255 + 0.5))
        fields.B.Text = tostring(math.floor(color.B * 255 + 0.5))
        row:SetAttribute("Color", color)
        if not silent and options.Callback then options.Callback(color) end
    end
    local function set(nextColor, silent)
        if type(nextColor) == "string" then
            local ok, result = pcall(Color3.fromHex, nextColor)
            if not ok then return end
            nextColor = result
        end
        if typeof(nextColor) ~= "Color3" then return end
        hue, saturation, brightness = nextColor:ToHSV()
        update(silent)
    end
    local open, alive = false, true
    local panelTween
    local activeInput, activeArea
    local function placePanel()
        local anchor = options.PanelAnchor or window
        local screen = gui.AbsoluteSize
        local x = anchor.AbsolutePosition.X + anchor.AbsoluteSize.X + 10
        if x + 250 > screen.X - 8 then x = anchor.AbsolutePosition.X - 260 end
        panel.Position = UDim2.fromOffset(math.clamp(x, 8, math.max(8, screen.X - 258)),
            math.clamp(swatch.AbsolutePosition.Y, 8, math.max(8, screen.Y - 254)))
    end
    local function setOpen(state)
        if open == state then return end
        if state and closeActiveDropdown then closeActiveDropdown() end
        open = state
        activeInput = nil
        if panelTween then panelTween:Cancel() end
        placePanel()
        if state then
            panel.Visible = true
            closeActiveDropdown = function() setOpen(false) end
        else
            closeActiveDropdown = nil
        end
        panelTween = TweenService:Create(panel,
            TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            { Size = UDim2.fromOffset(250, state and 244 or 0) })
        panelTween:Play()
        if not state then task.delay(0.25, function()
            if alive and not open then panel.Visible = false end
        end) end
    end
    local function fromPointer(position)
        if activeArea == palette then
            saturation = math.clamp((position.X - palette.AbsolutePosition.X) / palette.AbsoluteSize.X, 0, 1)
            brightness = 1 - math.clamp((position.Y - palette.AbsolutePosition.Y) / palette.AbsoluteSize.Y, 0, 1)
        elseif activeArea == hueBar then
            hue = math.clamp((position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
        end
        update(false)
    end
    for _, area in { palette, hueBar } do
        table.insert(dragConnections, area.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                activeArea, activeInput = area, input
                fromPointer(input.Position)
            end
        end))
    end
    table.insert(dragConnections, UserInputService.InputChanged:Connect(function(input)
        if activeInput and (input == activeInput or (activeInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement)) then fromPointer(input.Position) end
    end))
    table.insert(dragConnections, UserInputService.InputEnded:Connect(function(input)
        if input == activeInput then activeInput = nil end
    end))
    table.insert(dragConnections, swatch.Activated:Connect(function() setOpen(not open) end))
    table.insert(dragConnections, RunService.RenderStepped:Connect(function() if open then placePanel() end end))
    table.insert(dragConnections, fields.HEX.FocusLost:Connect(function()
        local ok, result = pcall(Color3.fromHex, fields.HEX.Text)
        if ok then set(result) else update(true) end
    end))
    for _, name in { "R", "G", "B" } do
        table.insert(dragConnections, fields[name].FocusLost:Connect(function()
            local red, green, blue = tonumber(fields.R.Text), tonumber(fields.G.Text), tonumber(fields.B.Text)
            if red and green and blue then
                set(Color3.fromRGB(math.clamp(red, 0, 255), math.clamp(green, 0, 255), math.clamp(blue, 0, 255)))
            else update(true) end
        end))
    end
    row.Destroying:Connect(function()
        alive = false
        activeInput = nil
        if panelTween then panelTween:Cancel() end
        if open then closeActiveDropdown = nil end
        panel:Destroy()
    end)
    update(true)
    return { Row = row, Get = function() return color end, Set = set, Destroy = function() row:Destroy() end }
end

