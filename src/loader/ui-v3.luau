local function installEmbeddedAssets()
    if type(writefile) ~= "function" or type(getcustomasset) ~= "function" then return end
    local function decode(data)
        if type(crypt) == "table" then
            local decoder = crypt.base64_decode or crypt.base64decode
            if type(decoder) == "function" then return decoder(data) end
        end
        local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        local lookup = {}
        for index = 1, #alphabet do lookup[alphabet:sub(index, index)] = index - 1 end
        local output = {}
        for index = 1, #data, 4 do
            local a = lookup[data:sub(index, index)] or 0
            local b = lookup[data:sub(index + 1, index + 1)] or 0
            local c = lookup[data:sub(index + 2, index + 2)] or 0
            local d = lookup[data:sub(index + 3, index + 3)] or 0
            local number = a * 262144 + b * 4096 + c * 64 + d
            local part = string.char(math.floor(number / 65536) % 256)
            if data:sub(index + 2, index + 2) ~= "=" then part ..= string.char(math.floor(number / 256) % 256) end
            if data:sub(index + 3, index + 3) ~= "=" then part ..= string.char(number % 256) end
            table.insert(output, part)
        end
        return table.concat(output)
    end
    if type(makefolder) == "function" then
