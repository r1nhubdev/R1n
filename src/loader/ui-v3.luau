function api.Notify(first, second)
    local options = second or first
    options = table.clone(options)
    options.Description = options.Description or options.Content or options.Text or ""
    return notify(options)
end
function api.Apply()
    local present = {}
    for order, config in api.Config.Tabs do
        local tab = tabs[config.Id]
        if tab then tab.Button.Parent.LayoutOrder = order end
        for _, sectionConfig in config.Sections do
            for _, props in sectionConfig.Components do
                local handle = api.Components[config.Id .. "." .. sectionConfig.Id .. "." .. props.Id]
                if handle then
                    present[handle] = true
                    handle.Instance.LayoutOrder = table.find(sectionConfig.Components, props) or 1
                    handle:SetName(props.Name or props.Title)
                    handle:SetDescription(props.Description or "")
                end
            end
        end
    end
    local removed = {}
    for prefix, handle in api.Components do
        if prefix == handle.Id and not prefix:find(".Settings.", 1, true) and not present[handle] then
            table.insert(removed, handle)
        end
    end
    for _, handle in removed do handle:Destroy() end
end
function api:CreateKeySystem(options)
    options = options or {}
    assert(type(options.Verify) == "function", "CreateKeySystem requires a Verify callback")
    self:CreateWindow({Title = options.Title or "Lowyx Hub", Description = "Key verification"})
    local tab = self:AddTab({Id = "KeySystem", Title = "Access", Icon = "settings"})
    local section = tab:AddSection({Id = "Verification", Name = "Verification", Column = 1})
    local status = section:AddParagraph({Id = "Status", Name = "Status", Description = "Enter your key to continue."})
    local input = section:AddInput({Id = "Key", Name = "Key", Placeholder = options.Placeholder or "Enter your key...",
        Default = type(options.Key) == "string" and options.Key or ""})
    local controller = {Gui = gui}
    local busy = false
    function controller:SetStatus(text) status:SetDescription(tostring(text or "")) end
    function controller:SetBusy(state) busy = state == true end
    function controller:GetKey() return input:Get() end
    function controller:SetKey(value) input:Set(value, true) end
    function controller:Destroy() api.Destroy() end
    section:AddButton({Id = "Verify", Name = "Verify Key", Callback = function()
        if busy then return end
        busy = true
        controller:SetStatus("Verifying...")
        local ok, accepted, message = pcall(options.Verify, input:Get())
        busy = false
        if not ok then
            controller:SetStatus("Verification failed. Try again.")
            return
        end
        controller:SetStatus(message or (accepted and "Key accepted." or "Invalid key."))
        if accepted then
            if options.OnSuccess then options.OnSuccess(input:Get()) end
            if options.CloseOnSuccess ~= false then controller:Destroy() end
        end
    end})
    local getKey = section:AddButton({Id = "GetKey", Name = "Get Key", Callback = function()
        if options.OnGetKey then
            local ok, message = pcall(options.OnGetKey)
            if ok and message then controller:SetStatus(message) end
            return
        end
        local link = options.KeyURL or "https://discord.gg/lowyx"
        if type(setclipboard) == "function" and pcall(setclipboard, link) then
            controller:SetStatus("Discord link copied: " .. link)
        else
            controller:SetStatus("Get your key: " .. link)
        end
    end})
    getKey.Instance.LayoutOrder = 5
    section.Instance.AutomaticSize = Enum.AutomaticSize.None
    section.Instance.Size = UDim2.new(1, -4, 0, 260)
    return controller
end
