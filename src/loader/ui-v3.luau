local function resolveIcon(name)
    if type(name) == "number" then return "rbxassetid://" .. tostring(name) end
    if type(name) == "string" and name:match("^rbxassetid://%d+$") then return name end
    return assert(NebulaSymbols[name], "Unknown Nebula icon: " .. tostring(name))
end

local contentAnimationId = 0
local contentTweens = {}
local function animateTabContent(page)
    contentAnimationId += 1
    local animationId = contentAnimationId
    for _, animation in contentTweens do animation:Cancel() end
    table.clear(contentTweens)
    local function tween(object, duration, goals)
        local animation = TweenService:Create(object,
            TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), goals)
        table.insert(contentTweens, animation)
        animation:Play()
    end
    local function reveal(group, delayTime, isSection)
        local entries = {}
        local function capture(item, property, initial)
            local key = "Entrance_" .. property
            local target = item:GetAttribute(key)
            if item.Name == "Checkbox" and property == "BackgroundTransparency" then
                target = group:GetAttribute("Enabled") and 0 or 0.5
                item:SetAttribute(key, target)
            end
            if target == nil then
                target = item[property]
                item:SetAttribute(key, target)
            end
            item[property] = initial or 1
            table.insert(entries, { Object = item, Property = property, Value = target })
        end
        capture(group, "BackgroundTransparency")
        for _, item in group:GetChildren() do
            if item:IsA("GuiObject") and item.Name ~= "Content" and not item:GetAttribute("KeepHidden") then
                local key = "EntrancePosition"
                local position = item:GetAttribute(key)
                if position == nil then
                    position = item.Position
                    item:SetAttribute(key, position)
                end
                item.Position = position + UDim2.fromOffset(14, 0)
                table.insert(entries, { Object = item, Property = "Position", Value = position })
                capture(item, "BackgroundTransparency")
                if item:IsA("TextLabel") then capture(item, "TextTransparency") end
                if item:IsA("ImageLabel") then capture(item, "ImageTransparency") end
                if not isSection then item.Visible = false end
            end
        end
        task.delay(delayTime, function()
            while introAlive and not introFinished do task.wait() end
            if not introAlive then return end
            if animationId ~= contentAnimationId or not group.Parent then return end
            for _, entry in entries do
                entry.Object.Visible = true
                tween(entry.Object, 0.18, { [entry.Property] = entry.Value })
            end
        end)
    end
    for _, column in page:GetChildren() do
        local sections = {}
        for _, section in column:GetChildren() do
            if section:IsA("Frame") then table.insert(sections, section) end
        end
        table.sort(sections, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
        for index, section in sections do
            local delayTime = (index - 1) * 0.05
            reveal(section, delayTime, true)
            local body = section:FindFirstChild("Content")
            if body then
                local components = {}
                for _, component in body:GetChildren() do
                    if component:IsA("Frame") then table.insert(components, component) end
                end
                table.sort(components, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
                for order, component in components do
                    reveal(component, delayTime + 0.1 + (order - 1) * 0.03, false)
                end
            end
        end
    end
end

local function selectTab(tab)
    if selectedTab == tab then return end
    selectedTab = tab
    gui:SetAttribute("SelectedTab", tab.Id)
    for _, entry in tabs do
        local selected = entry == tab
        entry.Page.Visible = selected
        local indicator = entry.Indicator
        if indicatorTweens[indicator] then indicatorTweens[indicator]:Cancel() end
        indicator.Visible = true
        local animation = TweenService:Create(indicator,
            TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Size = UDim2.fromOffset(4, selected and 18 or 0),
                BackgroundTransparency = selected and 0 or 1,
            })
        indicatorTweens[indicator] = animation
        animation:Play()
        entry.Button.BackgroundTransparency = selected and 0.72 or 0.88
    end
    animateTabContent(tab.Page)
end

local function createTab(options, order)
    assert(type(options.Id) == "string" and options.Id ~= "", "Tab Id is required")
    assert(not tabs[options.Id], "Duplicate tab Id: " .. options.Id)
    local image = resolveIcon(options.Icon)
    local button = Instance.new("TextButton")
    button.Name = options.Id
    button.Text = ""
    button.BackgroundColor3 = Color3.fromRGB(35, 35, 38)
    button.BackgroundTransparency = 0.88
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Size = UDim2.new(1, 0, 0, 34)
    button.LayoutOrder = order
    local row = Instance.new("Frame")
    row.Name = options.Id .. "Row"
    row.BackgroundTransparency = 1
    row.Size = button.Size
    row.LayoutOrder = order
    row.Parent = navigation
    button.Size = UDim2.fromScale(1, 1)
    button.Position = UDim2.fromOffset(48, 0)
