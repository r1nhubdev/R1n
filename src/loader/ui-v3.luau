local function dismissNotification(entry)
    if entry.Closing or not entry.Card.Parent then return end
    entry.Closing = true
    if entry.Move then entry.Move:Cancel() end
    TweenService:Create(entry.Card,
        TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
        { Position = entry.Card.Position + UDim2.fromOffset(350, 0), BackgroundTransparency = 1 }):Play()
    for _, item in entry.Card:GetDescendants() do
        if item:IsA("TextLabel") then
            TweenService:Create(item, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()
        elseif item:IsA("ImageLabel") then
            TweenService:Create(item, TweenInfo.new(0.2), { ImageTransparency = 1 }):Play()
        elseif item:IsA("UIShadow") then
            TweenService:Create(item, TweenInfo.new(0.2), { Transparency = 1 }):Play()
        end
    end
    arrangeNotifications()
