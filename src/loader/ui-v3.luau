    field.Text = value
    field.Parent = row
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = field
    local function set(nextValue, silent)
        local name = typeof(nextValue) == "EnumItem" and nextValue.Name or tostring(nextValue)
        local ok, key = pcall(function() return Enum.KeyCode[name] end)
        if not ok or not key then return end
        value = name
        field.Text = value
        row:SetAttribute("Keybind", value)
        if not silent and options.Callback then options.Callback(value) end
    end
    table.insert(dragConnections, field.Activated:Connect(function()
        if keybindCaptureActive and not capturing then return end
        capturing = not capturing
        keybindCaptureActive = capturing
        field.Text = capturing and "Press a key..." or value
    end))
    table.insert(dragConnections, UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if capturing then
            capturing = false
            keybindCaptureActive = false
            if input.KeyCode == Enum.KeyCode.Escape then
                field.Text = value
                return
            end
            if input.KeyCode ~= Enum.KeyCode.Unknown then set(input.KeyCode) end
        elseif not keybindCaptureActive and not UserInputService:GetFocusedTextBox()
            and input.KeyCode.Name == value and options.OnPressed then
            options.OnPressed()
        end
    end))
    row.Destroying:Connect(function()
        if capturing then keybindCaptureActive = false end
    end)
    set(value, true)
    return { Row = row, Get = function() return value end, Set = set, Destroy = function() row:Destroy() end }
end

