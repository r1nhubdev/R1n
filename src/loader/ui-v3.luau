    local titleLength = utf8.len(objects[6].Text) or #objects[6].Text
    local descriptionLength = utf8.len(objects[7].Text) or #objects[7].Text
    local buildTime, holdTime, eraseTime, pauseTime = 2.8, 5, 0.75, 0.15
    local phase = (os.clock() - headerStartedAt) % (buildTime + holdTime + eraseTime + pauseTime)
    local progress
    if phase < buildTime then
        progress = phase / buildTime
    elseif phase < buildTime + holdTime then
        progress = 1
    elseif phase < buildTime + holdTime + eraseTime then
        progress = 1 - (phase - buildTime - holdTime) / eraseTime
    else
        progress = 0
    end
    if not UIPreferences.Animations then progress = 1 end
    objects[6].MaxVisibleGraphemes = math.floor(titleLength * progress + 0.0001)
    objects[7].MaxVisibleGraphemes = math.floor(descriptionLength * progress + 0.0001)
    if iconAssetLoaded then
        local frame = 1 + math.floor(70 * progress)
        objects[8].ImageRectOffset = Vector2.new((frame % 11) * 90, math.floor(frame / 11) * 90)
        objects[8].ImageTransparency = 0
    else
        objects[8].ImageTransparency = 1 - progress
    end
end))
