    valueText.Position = UDim2.fromOffset(7, 0)
    valueText.Size = UDim2.new(1, -30, 1, 0)
    valueText.ClipsDescendants = true
    local arrow = Instance.new("Frame")
    arrow.Name = "Arrow"
    arrow.BackgroundTransparency = 1
    arrow.AnchorPoint = Vector2.new(0.5, 0.5)
    arrow.Position = UDim2.new(1, -13, 0.5, 0)
    arrow.Size = UDim2.fromOffset(10, 10)
    arrow.Parent = field
    for index, rotation in { 45, -45 } do
        local line = Instance.new("Frame")
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        line.Position = UDim2.fromOffset(index == 1 and 3 or 7, 5)
        line.Size = UDim2.fromOffset(6, 2)
        line.Rotation = rotation
        line.BackgroundColor3 = inactiveColor
        line.BorderSizePixel = 0
        line.Parent = arrow
        corner:Clone().Parent = line
    end
    local panel = Instance.new("Frame")
    panel.Name = "DropdownPanel_" .. row.Name
    panel.Size = UDim2.fromOffset(200, 0)
    panel.BackgroundColor3 = window.BackgroundColor3
    panel.BackgroundTransparency = window.BackgroundTransparency
    panel.BorderSizePixel = 0
    panel.ClipsDescendants = true
    panel.ZIndex = 50
    panel.Visible = false
    panel.Parent = gui
    objects[5]:Clone().Parent = panel
    corner:Clone().Parent = panel
    local caption = makeText(panel, "Title", options.Title or "Options", 13, activeColor)
    caption.Position = UDim2.fromOffset(12, 5)
    caption.Size = UDim2.new(1, -24, 0, 28)
    caption.ZIndex = 51
    local list = Instance.new("ScrollingFrame")
    list.Name = "Options"
    list.Position = UDim2.fromOffset(6, 38)
    list.Size = UDim2.new(1, -12, 1, -44)
    list.BackgroundTransparency = 1
    list.BorderSizePixel = 0
    list.CanvasSize = UDim2.new()
    list.AutomaticCanvasSize = Enum.AutomaticSize.Y
    list.ScrollBarThickness = 0
    list.ZIndex = 51
    list.Parent = panel
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 2)
    layout.Parent = list
    local selected, values, buttons, optionConnections = {}, {}, {}, {}
    local open, alive = false, true
    local animations = {}
    local closingId = 0
    local function getValue()
        if options.Multi then return table.clone(selected) end
        return selected[1]
    end
    local function update()
        valueText.Text = #selected > 0 and table.concat(selected, ", ") or (options.Placeholder or "Select...")
        valueText.TextColor3 = UIPreferences.ColorfulLetters and accentColor or (#selected > 0 and activeColor or inactiveColor)
        for value, button in buttons do
            local chosen = table.find(selected, value) ~= nil
            button.Label.TextColor3 = UIPreferences.ColorfulLetters and accentColor or (chosen and activeColor or inactiveColor)
            button:FindFirstChild("Selected").Visible = chosen
            button.BackgroundTransparency = chosen and 0.94 or 1
        end
    end
    local panelMoveTween
    local lastPanelGoal
    local parentPopupClose
    local ownedPopupClose
    local function placePanel()
        local screen = gui.AbsoluteSize
        local anchor = options.PanelAnchor or window
        local position, size = anchor.AbsolutePosition, anchor.AbsoluteSize
        local width = 200
        local height = math.min(#values, options.MaxVisible or 6) * 32 + 46
        local x = field.AbsolutePosition.X + field.AbsoluteSize.X - width
        x = math.clamp(x, position.X + 10, math.max(position.X + 10, position.X + size.X - width - 10))
        x = math.clamp(x, 8, math.max(8, screen.X - width - 8))
        local top = math.max(8, position.Y + 8)
        local bottom = math.min(screen.Y - 8, position.Y + size.Y - 8)
        local fieldTop = field.AbsolutePosition.Y
        local fieldBottom = fieldTop + field.AbsoluteSize.Y
        local spaceBelow = math.max(0, bottom - fieldBottom - 6)
        local spaceAbove = math.max(0, fieldTop - top - 6)
        local below = spaceBelow >= height or (spaceAbove < height and spaceBelow >= spaceAbove)
        height = math.min(height, below and spaceBelow or spaceAbove)
        local y = below and fieldBottom + 6 or fieldTop - height - 6
        local goal = Vector2.new(x, y)
        if not lastPanelGoal or not panel.Visible then
            panel.Position = UDim2.fromOffset(x, y)
            lastPanelGoal = goal
        elseif (goal - lastPanelGoal).Magnitude > 1 then
            if panelMoveTween then panelMoveTween:Cancel() end
            panelMoveTween = TweenService:Create(panel,
                TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                { Position = UDim2.fromOffset(x, y) })
            panelMoveTween:Play()
            lastPanelGoal = goal
        end
        return height
    end
    local function setOpen(state)
        if state == open then return end
        if state and closeDropdownOptions then closeDropdownOptions() end
        if state then parentPopupClose = closeActiveDropdown end
        open = state
        closingId += 1
        local id = closingId
        for _, animation in animations do animation:Cancel() end
        table.clear(animations)
        local height = placePanel()
        if open then
            panel.Visible = true
            closeDropdownOptions = function() setOpen(false) end
            ownedPopupClose = function()
                setOpen(false)
                if parentPopupClose then parentPopupClose() end
            end
            closeActiveDropdown = ownedPopupClose
        else
            closeDropdownOptions = nil
            if closeActiveDropdown == ownedPopupClose then closeActiveDropdown = parentPopupClose end
        end
        local function animate(object, goals)
            local animation = TweenService:Create(object,
                TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), goals)
            table.insert(animations, animation)
            animation:Play()
        end
        animate(panel, { Size = UDim2.fromOffset(200, open and height or 0) })
        animate(arrow, { Rotation = open and 180 or 0 })
        animate(field, { BackgroundTransparency = open and 0.88 or 0.94 })
        if not open then
            task.delay(0.25, function()
                if alive and closingId == id and not open then panel.Visible = false end
            end)
        end
    end
    local function refresh(newOptions)
        local source = newOptions or options.Options or {}
        if type(source) == "function" then
            local ok, result = pcall(source)
            if not ok or type(result) ~= "table" then return end
            source = result
        end
        local nextValues = {}
        for _, item in source do
            local value = tostring(item)
            if not table.find(nextValues, value) then table.insert(nextValues, value) end
        end
        if table.concat(nextValues, "\0") == table.concat(values, "\0") and next(buttons) then return end
        values = nextValues
        for _, connection in optionConnections do connection:Disconnect() end
        table.clear(optionConnections)
        for _, button in buttons do button:Destroy() end
        table.clear(buttons)
        for index, value in values do
            local button = Instance.new("TextButton")
            button.Name = value
            button.Size = UDim2.new(1, -4, 0, 30)
            button.LayoutOrder = index
            button.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
            button.BorderSizePixel = 0
            button.AutoButtonColor = false
            button.Text = ""
            button.ZIndex = 52
            button.Parent = list
            corner:Clone().Parent = button
            local label = makeText(button, "Label", value, 12, inactiveColor)
            label.Position = UDim2.fromOffset(16, 0)
            label.Size = UDim2.new(1, -22, 1, 0)
            label.ZIndex = 53
            local bar = Instance.new("Frame")
            bar.Name = "Selected"
            bar.AnchorPoint = Vector2.new(0, 0.5)
            bar.Position = UDim2.new(0, 5, 0.5, 0)
            bar.Size = UDim2.fromOffset(3, 16)
            bar.BackgroundColor3 = accentColor
            bar.BorderSizePixel = 0
            bar.ZIndex = 53
            bar.Parent = button
            corner:Clone().Parent = bar
            buttons[value] = button
            table.insert(optionConnections, button.Activated:Connect(function()
                if options.Multi then
                    local found = table.find(selected, value)
                    if found then table.remove(selected, found) else table.insert(selected, value) end
                else
                    selected = { value }
                end
                update()
                if options.Callback then options.Callback(getValue()) end
            end))
        end
        update()
        if open then panel.Size = UDim2.fromOffset(200, placePanel()) end
    end
    local function set(value, silent)
        selected = {}
        local defaults = type(value) == "table" and value or { value }
        for _, item in defaults do
            item = tostring(item)
            if table.find(values, item) and not table.find(selected, item) then
                table.insert(selected, item)
                if not options.Multi then break end
            end
        end
        update()
        if not silent and options.Callback then options.Callback(getValue()) end
    end
    refresh()
    set(options.Default, true)
    table.insert(dragConnections, field.Activated:Connect(function()
        if not open then refresh() end
        setOpen(not open)
    end))
    table.insert(dragConnections, RunService.RenderStepped:Connect(function()
        if open then placePanel() end
    end))
    row.Destroying:Connect(function()
        alive = false
        dropdownOpeners[row] = nil
        if panelMoveTween then panelMoveTween:Cancel() end
        if open then closeActiveDropdown = nil end
        for _, animation in animations do animation:Cancel() end
        for _, connection in optionConnections do connection:Disconnect() end
        panel:Destroy()
    end)
    if options.AutoReload then
        task.spawn(function()
            while alive do
                task.wait(math.max(0.5, options.ReloadInterval or 3))
                if not alive then break end
                refresh()
            end
        end)
    end
    dropdownOpeners[row] = function()
        refresh()
        setOpen(true)
    end
    return { Row = row, Get = getValue, Set = set, Refresh = refresh, Destroy = function() row:Destroy() end }
end

