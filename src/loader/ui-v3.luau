local function newSection(body, frame, config, prefix)
    config.Components = config.Components or {}
    local section = {Config = config, Body = body, Instance = frame, Id = prefix}
    function section:AddComponent(props)
        sequence += 1
        props.Id = props.Id or "control" .. sequence
        if not props.PanelAnchor and frame.Name:match("^ControlSettings_") then props.PanelAnchor = frame end
        table.insert(config.Components, props)
        return makeComponent(body, props, prefix .. "." .. props.Id)
    end
    for _, kind in {"Toggle", "IconToggle", "ColorToggle", "Slider", "Dropdown", "MultiDropdown",
        "ColorPicker", "Keybind", "Input", "Button", "Paragraph"} do
        section["Add" .. kind] = function(self, props)
            props = props or {}
            props.Type = kind
            return self:AddComponent(props)
        end
    end
    return section
end
makeComponent = function(body, props, prefix)
    normalize(props)
    local kind = props.Type or "Toggle"
    local userCallback = props.Callback
    local native
    local handle: any = {Config = props, Id = prefix, ColorId = prefix .. ".Color"}
    local value = props.Default
    local color = props.Color or (kind == "ColorPicker" and props.Default) or accentColor
    if typeof(color) ~= "Color3" then color = accentColor end
    local muted = false
    local renderProps = table.clone(props)
    renderProps.Callback = function(nextValue)
        value = nextValue
        if kind == "ColorPicker" then color = nextValue end
        if not muted then
            changed:Fire(prefix, nextValue)
            if userCallback then userCallback(nextValue) end
        end
    end
    if kind == "Toggle" or kind == "IconToggle" or kind == "ColorToggle" then
        native = createToggle(body, renderProps)
    elseif kind == "Slider" then
        native = createSlider(body, renderProps)
    elseif kind == "Dropdown" or kind == "MultiDropdown" then
        native = createDropdown(body, renderProps)
    elseif kind == "ColorPicker" then
        renderProps.Default = color
        native = createColorPicker(body, renderProps)
    elseif kind == "Keybind" then
        native = createKeybind(body, renderProps)
    elseif kind == "Button" then
        native = createButton(body, renderProps)
    elseif kind == "Paragraph" then
        native = createParagraph(body, renderProps)
    elseif kind == "Input" then
        native = createInput(body, renderProps)
    else
        error("Unsupported Lowyx component: " .. tostring(kind))
    end
    local row = native.Row
    handle.Instance = row
    row:SetAttribute("ComponentId", prefix)
    row:SetAttribute("LowyxComponent", true)
    registerHandle(handle, prefix, kind)
    function handle:Get()
        if kind == "Button" then return nil end
        if kind == "Paragraph" then return props.Description end
        return native.Get and native.Get() or value
    end
    function handle:Set(nextValue, silent)
        if kind == "Paragraph" then return self:SetDescription(nextValue) end
        muted = silent == true
        if native.Set then native.Set(nextValue, muted) end
        value = native.Get and native.Get() or nextValue
        muted = false
        return self
    end
    handle.GetValue = handle.Get
    handle.SetValue = handle.Set
    handle.Select = handle.Set
    function handle:SetCallback(callback)
        userCallback = callback
        props.Callback = callback
        return self
    end
    function handle:SetOptions(values)
        props.Options = values
        renderProps.Options = values
        if native.Refresh then native.Refresh(values) end
        return self
    end
    handle.Refresh = handle.SetOptions
    function handle:SetDescription(text)
        props.Description = tostring(text or "")
        renderProps.Description = props.Description
        if native.SetDescription then
            native.SetDescription(props.Description)
        else
            local label = row:FindFirstChild("Description") or row:FindFirstChild("Subtitle")
            if label then label.Text = props.Description end
        end
        return self
    end
    function handle:SetName(text)
        props.Name, props.Title = tostring(text), tostring(text)
        if native.SetTitle then
            native.SetTitle(props.Title)
        else
            local label = row:FindFirstChild("Title")
            if label then label.Text = props.Title end
        end
        return self
    end
    handle.SetTitle = handle.SetName
    function handle:GetColor() return color end
    function handle:SetColor(nextColor)
        if typeof(nextColor) ~= "Color3" then return self end
        color = nextColor
        props.Color = color
        if handle.ColorControl then handle.ColorControl:Set(color, true) end
        if kind == "ColorPicker" then self:Set(color) end
        changed:Fire(prefix .. ".Color", color)
        return self
    end
    function handle:Destroy()
        if native.Destroy then native.Destroy() else row:Destroy() end
        api.Components[prefix] = nil
    end
    if kind == "IconToggle" or kind == "ColorToggle" then
        local panel = Instance.new("Frame")
        panel.Name = "ControlSettings_" .. prefix
        panel.Size = UDim2.fromOffset(300, 0)
        panel.BackgroundColor3 = window.BackgroundColor3
        panel.BackgroundTransparency = window.BackgroundTransparency
        panel.BorderSizePixel = 0
        panel.ClipsDescendants = true
        panel.Visible = false
        panel.ZIndex = 50
        panel.Parent = gui
        objects[3]:Clone().Parent = panel
        objects[5]:Clone().Parent = panel
        local heading = Instance.new("TextLabel")
        heading.Size = UDim2.new(1, -24, 0, 36)
        heading.Position = UDim2.fromOffset(12, 0)
        heading.BackgroundTransparency = 1
        heading.FontFace = tabFont
        heading.TextSize = 14
        heading.TextColor3 = activeColor
        heading.TextXAlignment = Enum.TextXAlignment.Left
        heading.Text = props.SettingsConfig and props.SettingsConfig.Title or props.Title .. " settings"
        heading.ZIndex = 51
        heading.Parent = panel
        local contentBody = Instance.new("ScrollingFrame")
        contentBody.Name = "Content"
        contentBody.Size = UDim2.new(1, -24, 1, -48)
        contentBody.Position = UDim2.fromOffset(12, 38)
        contentBody.BackgroundTransparency = 1
        contentBody.BorderSizePixel = 0
        contentBody.ScrollBarThickness = 0
        contentBody.AutomaticCanvasSize = Enum.AutomaticSize.Y
        contentBody.CanvasSize = UDim2.new()
        contentBody.ZIndex = 51
        contentBody.Parent = panel
        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 2)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = contentBody
        local nested = newSection(contentBody, panel, {Components = {}}, prefix .. ".Settings")
        local colorControl = nested:AddColorPicker({Id = "Color", Name = "Color", Default = color,
            PanelAnchor = panel, Callback = function(nextColor)
                color, props.Color = nextColor, nextColor
                changed:Fire(prefix .. ".Color", nextColor)
            end})
        handle.ColorControl = colorControl
        for _, setting in props.Settings or {} do nested:AddComponent(setting) end
        for _, item in panel:GetDescendants() do
            if item:IsA("GuiObject") then item.ZIndex = math.max(51, item.ZIndex) end
        end
        local gear = Instance.new("ImageButton")
        gear.Name = "Settings"
        gear.AnchorPoint = Vector2.new(1, 0.5)
        gear.Position = UDim2.new(1, -32, 0.5, 0)
        gear.Size = UDim2.fromOffset(18, 18)
        gear.BackgroundTransparency = 1
        gear.Image = NebulaSymbols.settings
        gear.ImageColor3 = inactiveColor
        gear.Parent = row
        local title = row:FindFirstChild("Title")
        local description = row:FindFirstChild("Description")
        if title then title.Size = UDim2.new(1, -62, 0, 18) end
        if description then description.Size = UDim2.new(1, -62, 0, 14) end
        local opened, transition = false, nil
        local function place()
            local screen = gui.AbsoluteSize
            local x = window.AbsolutePosition.X + window.AbsoluteSize.X + 8
            if x + 300 > screen.X then x = window.AbsolutePosition.X - 308 end
            panel.Position = UDim2.fromOffset(math.clamp(x, 8, math.max(8, screen.X - 308)),
                math.clamp(row.AbsolutePosition.Y, 8, math.max(8, screen.Y - 448)))
        end
        local function open(state)
            if state == opened then return end
            if state and closeActiveDropdown then closeActiveDropdown() end
            if not state and closeDropdownOptions then closeDropdownOptions() end
            opened = state
            if transition then transition:Cancel() end
            place()
            if state then panel.Visible = true end
            closeActiveDropdown = state and function() open(false) end or nil
            local height = math.min(440, math.max(150, layout.AbsoluteContentSize.Y + 50), gui.AbsoluteSize.Y - 24)
            transition = TweenService:Create(panel, TweenInfo.new(0.2), {Size = UDim2.fromOffset(300, state and height or 0)})
            transition:Play()
            if not state then task.delay(0.2, function() if not opened then panel.Visible = false end end) end
        end
        table.insert(dragConnections, gear.Activated:Connect(function() open(not opened) end))
        table.insert(dragConnections, RunService.RenderStepped:Connect(function() if opened then place() end end))
        row.Destroying:Connect(function()
            if transition then transition:Cancel() end
            panel:Destroy()
        end)
        function handle:OpenSettings()
            open(true)
            return self
        end
        function handle:CloseSettings()
            open(false)
            return self
        end
        function handle:ToggleSettings()
            open(not opened)
            return self
        end
        function handle:AddComponent(config) return nested:AddComponent(config) end
    end
    return handle
end
function api:CreateWindow(options)
    options = options or {}
    Configuration.Title = options.Title or "Lowyx Hub"
    Configuration.Description = options.Description or (options.Name or "Roblox Game"):gsub("^R1n Hub%s*|%s*", "")
    objects[6].Text, objects[7].Text = Configuration.Title, Configuration.Description
    api.Window:SetAttribute("LowyxUI", true)
    return api
end
function api:AddTab(config)
    config = config or {}
    config.Id = config.Id or "tab" .. (#api.Config.Tabs + 1)
    config.Title = config.Title or config.Name or config.Id
    config.Description = config.Description or ""
    config.Icon = nebulaIcon(config.Title, config.Icon)
    config.Sections = config.Sections or {}
    table.insert(api.Config.Tabs, config)
    navigationOrder += 1
    local nativeTab = createTab(config, navigationOrder)
    local tab = {Id = config.Id, Config = config, Instance = nativeTab.Page}
    function tab:AddSection(sectionConfig)
        sectionConfig = sectionConfig or {}
        sectionConfig.Id = sectionConfig.Id or "section" .. (#config.Sections + 1)
        sectionConfig.Name = sectionConfig.Name or sectionConfig.Title or sectionConfig.Id
        sectionConfig.Column = sectionConfig.Column == 2 and 2 or 1
        sectionConfig.Components = sectionConfig.Components or {}
        table.insert(config.Sections, sectionConfig)
        sectionConfig.Icon = nebulaIcon(sectionConfig.Name, sectionConfig.Icon)
        local body = createSection(config.Id, sectionConfig.Column, sectionConfig.Name, sectionConfig.Icon)
        local frame = body.Parent
        frame.Name = sectionConfig.Id
        frame.LayoutOrder = sectionConfig.Order or #config.Sections
        local section = newSection(body, frame, sectionConfig, config.Id .. "." .. sectionConfig.Id)
        local children = table.clone(sectionConfig.Components)
        table.clear(sectionConfig.Components)
        for _, props in children do section:AddComponent(props) end
        return section
    end
    function tab:AddSeparator(options) return api:AddSeparator(options) end
    if not selectedTab then selectTab(nativeTab) end
    return tab
end
function api:AddSeparator(options)
    options = type(options) == "string" and {Title = options} or (options or {})
    navigationOrder += 1
    createSeparator(options.Title or options.Name or "General", navigationOrder)
    local label = separators[#separators].Label
    label.Size = UDim2.new(1, 0, 0, 24)
    label.TextTransparency = 0
    return {Instance = label, SetTitle = function(_, text) label.Text = text end,
        Destroy = function() label:Destroy() end}
end
api.CreateTab = api.AddTab
function api:GetComponent(id) return api.Components[id] end
function api.SelectTab(first, second)
    local id = second or first
    local tab = tabs[type(id) == "table" and id.Id or id]
    if tab then
        selectTab(tab)
        return true
    end
    return false
end
function api.GetValue(id)
    local handle = api.Components[id]
    return handle and handle:Get()
