local applyingTheme = false
local function applyUITheme()
    if applyingTheme then return end
    applyingTheme = true
    accentColor = Color3.fromRGB(UIPreferences.Color[1], UIPreferences.Color[2], UIPreferences.Color[3])
    for _, item in gui:GetDescendants() do
        if item:IsA("Frame") and (item.Name == "Selected" or item.Name == "Fill") then
            item.BackgroundColor3 = accentColor
        elseif item:IsA("TextButton") and item.Name == "Checkbox" then
            local enabled = item.Parent:GetAttribute("Enabled")
            if enabled then item.BackgroundColor3 = accentColor end
            local glow = item:FindFirstChild("WhiteShadow")
            if glow then glow.Color = accentColor end
            for _, child in item:GetChildren() do
                if child:IsA("UIStroke") and enabled then child.Color = accentColor end
            end
        end
        if item:IsA("TextLabel") or item:IsA("TextButton") or item:IsA("TextBox") then
            local base = item:GetAttribute("OriginalTextColor")
            if not base then
                base = item.TextColor3
                item:SetAttribute("OriginalTextColor", base)
            end
            item.TextColor3 = UIPreferences.ColorfulLetters and accentColor or base
        end
    end
    local alpha = math.clamp(UIPreferences.Transparency / 100, 0, 0.85)
    window.BackgroundTransparency = alpha
    settingsPanel.BackgroundTransparency = alpha
    performanceBackground.BackgroundTransparency = alpha
    for _, item in gui:GetChildren() do
        if item.Name:match("^DropdownPanel_") then
            item.BackgroundTransparency = alpha
        end
    end
    applyingTheme = false
end
