local function createParagraph(parent, options)
    local row = Instance.new("Frame")
    row.Name = options.Title or "Paragraph"
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 64)
    row.AutomaticSize = Enum.AutomaticSize.Y
    row.LayoutOrder = #parent:GetChildren()
    row.Parent = parent
    local iconWidth = options.Icon and 30 or 0
    if options.Icon then
        local icon = Instance.new("ImageLabel")
        icon.Name = "Icon"
        icon.Position = UDim2.fromOffset(2, 7)
        icon.Size = UDim2.fromOffset(20, 20)
        icon.BackgroundTransparency = 1
        icon.Image = resolveIcon(options.Icon)
        icon.ImageColor3 = inactiveColor
        icon.Parent = row
    end
    local function escape(text)
        return (tostring(text):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"))
    end
    local function colorTag(color)
        if typeof(color) == "Color3" then
            return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5),
                math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
        end
        return tostring(color)
    end
    local function render(text)
        if options.RichText then return text end
        local colors = options.WordColors or {}
        local result = {}
        local cursor = 1
        while cursor <= #text do
            local foundStart, foundEnd, foundColor
            for word, color in colors do
                if word ~= "" then
                    local first, last = text:find(word, cursor, true)
                    if first and (not foundStart or first < foundStart or
                        (first == foundStart and last > foundEnd)) then
                        foundStart, foundEnd, foundColor = first, last, color
                    end
                end
            end
            if not foundStart then
                table.insert(result, escape(text:sub(cursor)))
                break
            end
            table.insert(result, escape(text:sub(cursor, foundStart - 1)))
            table.insert(result, '<font color="' .. escape(colorTag(foundColor)) .. '">' ..
                escape(text:sub(foundStart, foundEnd)) .. '</font>')
            cursor = foundEnd + 1
        end
        return table.concat(result)
    end
    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Position = UDim2.fromOffset(iconWidth + 2, 4)
    title.Size = UDim2.new(1, -iconWidth - 4, 0, 20)
    title.BackgroundTransparency = 1
    title.FontFace = tabFont
    title.TextSize = 14
    title.TextColor3 = activeColor
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.RichText = true
    title.Text = render(options.Title or "Paragraph")
    title.Parent = row
    local description = Instance.new("TextLabel")
    description.Name = "Description"
    description.Position = UDim2.fromOffset(iconWidth + 2, 23)
    description.Size = UDim2.new(1, -iconWidth - 4, 0, 27)
    description.AutomaticSize = Enum.AutomaticSize.Y
    description.BackgroundTransparency = 1
    description.FontFace = Font.new("rbxasset://fonts/families/Roboto.json", Enum.FontWeight.Medium)
    description.TextSize = 12
    description.TextColor3 = inactiveColor
    description.TextXAlignment = Enum.TextXAlignment.Left
    description.TextYAlignment = Enum.TextYAlignment.Top
    description.TextWrapped = true
    description.RichText = true
    description.Text = render(options.Description or "")
    description.Parent = row
    return {
        Row = row,
        SetTitle = function(text)
            title.Text = render(text)
            row.Name = text
        end,
        SetDescription = function(text) description.Text = render(text) end,
        SetWordColors = function(colors)
            options.WordColors = colors
            title.Text = render(title.ContentText)
            description.Text = render(description.ContentText)
        end,
        Destroy = function() row:Destroy() end,
    }
end

