local function buildWindow(initialOptions)
    installEmbeddedAssets()
local function lowyxAsset(path, fallback)
    local ok, asset = pcall(function() return getcustomasset(path) end)
    return ok and asset or fallback
end
local UIPreferences = {
    Transparency = 0, Keybind = "LeftControl", Animations = true, Loading = true,
    Color = { 245, 245, 245 }, ColorfulLetters = false,
}
pcall(function()
    local saved = game:GetService("HttpService"):JSONDecode(readfile(initialOptions.SettingsFile or "Lowyx/UISettings.json"))
    for key in UIPreferences do
        if saved[key] ~= nil then UIPreferences[key] = saved[key] end
    end
end)
if initialOptions.LoadingScreen ~= nil then UIPreferences.Loading = initialOptions.LoadingScreen end
if initialOptions.Animations ~= nil then UIPreferences.Animations = initialOptions.Animations end
if initialOptions.Keybind ~= nil then
    UIPreferences.Keybind = typeof(initialOptions.Keybind) == "EnumItem" and initialOptions.Keybind.Name or initialOptions.Keybind
end
if typeof(initialOptions.Color) == "Color3" then
    UIPreferences.Color = {math.floor(initialOptions.Color.R * 255 + 0.5), math.floor(initialOptions.Color.G * 255 + 0.5), math.floor(initialOptions.Color.B * 255 + 0.5)}
end
local accentColor = Color3.fromRGB(UIPreferences.Color[1], UIPreferences.Color[2], UIPreferences.Color[3])
local preferenceRevision = 0
local function saveUIPreferences()
    if initialOptions.SaveSettings == false then return end
    preferenceRevision += 1
    local revision = preferenceRevision
    task.delay(0.35, function()
        if revision ~= preferenceRevision then return end
        pcall(function()
            writefile(initialOptions.SettingsFile or "Lowyx/UISettings.json", game:GetService("HttpService"):JSONEncode(UIPreferences))
        end)
    end)
end
