function api.SetValue(id, value)
    local handle = api.Components[id]
    return handle and handle:Set(value)
end
function api.GetColor(id)
    local handle = api.Components[id]
    return handle and handle:GetColor()
end
function api.SetColor(id, value)
    local handle = api.Components[id]
